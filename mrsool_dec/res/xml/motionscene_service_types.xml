<?xml version="1.0" encoding="utf-8"?>
<MotionScene
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Transition app:constraintSetEnd="@id/end" app:constraintSetStart="@id/start" app:duration="350" app:motionInterpolator="easeInOut" />
    <ConstraintSet android:id="@id/start">
        <ConstraintOverride android:id="@id/serviceRow3" android:layout_height="0.0dp" android:layout_marginTop="0.0dp" app:layout_constraintTop_toBottomOf="@id/serviceRow2" />
        <ConstraintOverride android:id="@id/toggleBtn" android:paddingTop="4.0dp" android:paddingBottom="4.0dp" android:minWidth="0.0dp" app:layout_constraintTop_toBottomOf="@id/serviceRow2" />
    </ConstraintSet>
    <ConstraintSet android:id="@id/end">
        <ConstraintOverride android:id="@id/serviceRow3" android:layout_height="wrap_content" android:layout_marginTop="8.0dp" app:layout_constraintTop_toBottomOf="@id/serviceRow2" />
        <ConstraintOverride android:id="@id/toggleBtn" android:paddingTop="0.0dp" android:paddingBottom="0.0dp" android:minWidth="130.0dp" app:layout_constraintTop_toBottomOf="@id/serviceRow3" />
    </ConstraintSet>
    <ConstraintSet android:id="@id/disableToggle">
        <ConstraintOverride android:id="@id/toggleBtn" android:visibility="gone" android:layout_height="0.0dp" android:layout_marginTop="0.0dp" />
        <ConstraintOverride android:id="@id/serviceRow3" android:visibility="gone" android:layout_height="0.0dp" android:layout_marginTop="0.0dp" />
    </ConstraintSet>
</MotionScene>
