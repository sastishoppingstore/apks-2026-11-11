<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/foreground_color_1" />
            <stroke android:width="2.0dp" android:color="@color/primary_action" android:dashWidth="0.0dp" />
            <corners android:radius="4.0dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/foreground_color_1" />
            <stroke android:width="2.0dp" android:color="@color/error_color" android:dashWidth="0.0dp" />
            <corners android:radius="4.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/foreground_color_1" />
            <stroke android:width="2.0dp" android:color="@color/ternary_color" android:dashWidth="0.0dp" />
            <corners android:radius="4.0dp" />
        </shape>
    </item>
</selector>
