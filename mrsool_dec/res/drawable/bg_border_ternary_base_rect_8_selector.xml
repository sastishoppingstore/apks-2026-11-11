<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke android:width="1.0dp" android:color="@color/primary_action" />
            <corners android:topLeftRadius="8.0dp" android:topRightRadius="8.0dp" android:bottomLeftRadius="8.0dp" android:bottomRightRadius="8.0dp" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <stroke android:width="1.0dp" android:color="@color/ternary_color" />
            <corners android:topLeftRadius="8.0dp" android:topRightRadius="8.0dp" android:bottomLeftRadius="8.0dp" android:bottomRightRadius="8.0dp" />
        </shape>
    </item>
</selector>
